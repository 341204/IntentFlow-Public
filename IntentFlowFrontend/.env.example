# Shared model settings for the full-stack Docker Compose deployment.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Java backend: set SPRING_PROFILES_ACTIVE=deepseek to use DeepSeek.
SPRING_PROFILES_ACTIVE=anthropic
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Change this example password before deployment.
REDIS_PASSWORD=intentflow123
FRONTEND_PORT=5174

# Optional Vite development settings.
VITE_DEFAULT_BACKEND=python
VITE_PYTHON_API_URL=/api/python
VITE_JAVA_API_URL=/api/java
